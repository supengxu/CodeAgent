{
  "Agent": {
    "Chat": {
      "SystemPrompt": "You are a helpful coding assistant.",
      "MaxTokens": 4096,
      "EnableThinking": false
    },
    "LoopControl": {
      "MaxIterations": 15,
      "TokenLimitRatio": 0.8,
      "CycleDetectionWindow": 5
    },
    "Planning": {
      "ComplexityThreshold": 500,
      "TimeoutSeconds": 100,
      "MinToolCallsForComplex": 3
    },
    "Provider": {
      "Name": "OpenAI",
      "Model": "gpt-4o"
    },
    "Session": {
      "SessionsDirectory": "sessions"
    },
    "Context": {
      "CompressionThreshold": 100000,
      "MinRecentTurns": 4,
      "ProtectedContextTypes": ["system", "tool_definition"]
    }
  }
}